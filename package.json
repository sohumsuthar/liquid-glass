{
  "name": "@sohumsuthar/liquid-glass",
  "version": "3.1.0",
  "description": "Liquid Glass for the web, calibrated against macOS 26 Control Center rather than eyeballed: measured transfer curve, ray-traced SVG refraction, measured specular rim, React + CSS.",
  "sideEffects": [
    "*.css"
  ],
  "main": "components/index.js",
  "module": "components/index.js",
  "exports": {
    ".": "./components/index.js",
    "./css/*": "./css/*",
    "./hooks": "./hooks/useLiquidGlassEffects.jsx",
    "./hooks/useLiquidGlassEffects": "./hooks/useLiquidGlassEffects.jsx",
    "./hooks/useLiquidLens": "./hooks/useLiquidLens.jsx",
    "./hooks/*": "./hooks/*",
    "./lib/*": "./lib/*",
    "./optics": "./lib/glass-optics.mjs",
    "./components/*": "./components/*"
  },
  "files": [
    "css",
    "components",
    "hooks",
    "lib",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate-displacement-map": "node scripts/generate-displacement-map.mjs",
    "build-demo": "node scripts/build-demo.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "sharp": "^0.34.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohumsuthar/liquid-glass.git"
  },
  "homepage": "https://sohumsuthar.github.io/liquid-glass/demo/",
  "author": "Sohum Suthar",
  "license": "MIT",
  "keywords": [
    "glass",
    "glassmorphism",
    "liquid-glass",
    "ui",
    "react",
    "css",
    "design-system",
    "physics",
    "refraction",
    "snell-law",
    "backdrop-filter",
    "frosted-glass",
    "apple",
    "macos",
    "ios",
    "svg-filter",
    "feDisplacementMap",
    "snell",
    "tahoe"
  ],
  "bugs": {
    "url": "https://github.com/sohumsuthar/liquid-glass/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
